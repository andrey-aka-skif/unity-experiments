<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Experiment08.UIToolkits/UI/ClickerGameUss.uss?fileID=7433441132597879392&amp;guid=93db60b9b98174f4b9adbe0972ad7bea&amp;type=3#ClickerGameUss" />
    <engine:VisualElement name="NewGameWindow" class="menuText gameWindow" style="display: flex;">
        <engine:VisualElement name="Panel" class="gamePanel" style="min-width: 200px;">
            <engine:Label text="Новая игра" name="PanelLabel" class="headText" />
            <engine:VisualElement name="BestScoreLine" style="flex-grow: 1; flex-direction: row; justify-content: center;">
                <engine:Label text="Лучший результат:" name="BestScoreLabel" />
                <engine:Label text="0" name="BestScoreValue" />
            </engine:VisualElement>
            <engine:Button text="Играть" name="PlayButton" class="menuButton mainAction" />
            <engine:Button text="Выйти" name="ExitButton" class="menuButton" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="PauseGameWindow" class="menuText gameWindow" style="display: none;">
        <engine:VisualElement name="Panel" class="gamePanel" style="min-width: 200px;">
            <engine:Label text="Пауза" name="PanelLabel" class="headText" />
            <engine:VisualElement name="ScoreLine" style="flex-grow: 1; flex-direction: row; justify-content: center;">
                <engine:Label text="Результат:" name="ScoreLabel" />
                <engine:Label text="0" name="ScoreValue" />
            </engine:VisualElement>
            <engine:VisualElement name="BestScoreLine" style="flex-grow: 1; flex-direction: row; justify-content: center;">
                <engine:Label text="Лучший результат:" name="BestScoreLabel" />
                <engine:Label text="0" name="BestScoreValue" />
            </engine:VisualElement>
            <engine:Button text="Продолжить" name="ResumeButton" class="menuButton mainAction" />
            <engine:Button text="Перезапустить" name="RestartButton" class="menuButton" />
            <engine:Button text="Выйти" name="ExitButton" class="menuButton" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="EndGameWindow" class="menuText gameWindow" style="display: none;">
        <engine:VisualElement name="Panel" class="gamePanel" style="min-width: 200px;">
            <engine:Label text="Игра окончена" name="PanelLabel" class="headText" />
            <engine:VisualElement name="ScoreLine" style="flex-grow: 1; flex-direction: row; justify-content: center;">
                <engine:Label text="Результат:" name="ScoreLabel" />
                <engine:Label text="0" name="ScoreValue" />
            </engine:VisualElement>
            <engine:VisualElement name="BestScoreLine" style="flex-grow: 1; flex-direction: row; justify-content: center;">
                <engine:Label text="Лучший результат:" name="BestScoreLabel" />
                <engine:Label text="0" name="BestScoreValue" />
            </engine:VisualElement>
            <engine:Button text="Играть снова" name="RestartButton" class="menuButton mainAction" />
            <engine:Button text="Выйти" name="ExitButton" class="menuButton" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
